# ==============================================================================
# Mine Glow Organics — Environment Configuration
# ==============================================================================

PORT=5500
SESSION_SECRET=mineglow_super_secret_session_key_2026

# ==============================================================================
# OPTION 1: GMAIL SMTP / CUSTOM SMTP (RECOMMENDED FOR ANY CUSTOMER EMAIL)
# To use Gmail: Enable 2-Step Verification on your Google Account, then go to
# https://myaccount.google.com/apppasswords to create a 16-character App Password.
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=gauravsharma2000gk@gmail.com
SMTP_PASS=your_16_digit_app_password

# ==============================================================================
# OPTION 2: RESEND API (Requires Custom Domain Verification for Customer Emails)
# Note: onboarding@resend.dev only allows sending to the Resend account owner email.
# To send to customers, verify your domain on resend.com and set EMAIL_FROM with it.
# ==============================================================================
RESEND_API_KEY=re_your_api_key_here

# ==============================================================================
# SENDER & STORE OWNER EMAIL CONFIGURATION
# ==============================================================================
EMAIL_FROM=Mine Glow Organics <gauravsharma2000gk@gmail.com>
OWNER_EMAIL=gauravsharma2000gk@gmail.com

# ==============================================================================
# RAZORPAY PAYMENT GATEWAY (Optional - For Online Payments)
# ==============================================================================
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_secret

# ==============================================================================
# SUPABASE DATABASE (Optional - For Production Persistence)
# ==============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key
